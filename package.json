{
  "name": "proos",
  "version": "0.1.0",
  "private": true,
  "description": "ProOS — Practice Operating System for Indian CA / CS / CMA firms (AQMM v2.0, GST IMS, compliance automation)",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "next lint",
    "test": "vitest run",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "setup": "npm run db:push && npm run db:seed",
    "worker": "tsx scripts/worker.ts",
    "schema:pg": "node scripts/make-postgres-schema.js",
    "db:push:pg": "node scripts/make-postgres-schema.js && prisma db push --schema prisma/schema.postgres.prisma",
    "db:generate:pg": "node scripts/make-postgres-schema.js && prisma generate --schema prisma/schema.postgres.prisma",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "check:integrations": "tsx scripts/check-integrations.ts",
    "surepass:contract": "tsx scripts/surepass-contract.ts",
    "check:docker": "node scripts/check-dockerfile.js"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.4.0",
    "imapflow": "^1.0.171",
    "mailparser": "^3.7.2",
    "next": "^15.1.6",
    "nodemailer": "^6.9.16",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/mailparser": "^3.4.5",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prisma": "^6.4.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
